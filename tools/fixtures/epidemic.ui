# An epidemic among walkers: monitors, plots drawn by R, reports, and
# downloads. Test model for TOFIX item 4 (not in the preset menu).

panel run "Run"
  button setup
  button go forever .right()
  slider population 50..500 = 200 step 10
  slider initial_infected "initially infected" 1..20 = 3 step 1
  slider infection_chance "infection chance (%)" 0..100 = 40 step 5
  slider illness_ticks "illness (ticks)" 5..100 = 30 step 5
  button export "Export CSV" {
    write.csv(history, "epidemic.csv", row.names = FALSE)
    workbench_download("epidemic.csv")
  } w 4
end

panel now "Now" .under(run)
  monitor susceptible "Susceptible" { sum(of(agents = turtles, var = "state") == 0) }
  monitor infected "Infected" { sum(of(agents = turtles, var = "state") == 1) } .right()
  monitor ever_infected "% ever infected" { 100 * (1 - tail(history$susceptible, 1) / population) } digits 1 w 4
end

view w 8 h 8 .right(run)

plot epidemic "Epidemic curve" {
  matplot(history$tick, history[, c("susceptible", "infected", "recovered")], type = "l", lty = 1, lwd = 2,
          col = state_colours, xlab = "ticks", ylab = "people", ylim = c(0, population))
  legend("right", legend = c("susceptible", "infected", "recovered"), col = state_colours, lwd = 2, bty = "n", cex = 0.8)
} w 10 h 4 .right(view)

plot split "Right now" {
  barplot(unlist(tail(history[, -1], 1)), col = state_colours, border = NA, ylim = c(0, population))
} update monitor w 4 h 4 .under(epidemic)

report recent "Last ticks" { tail(history, 5) } w 6 h 4 .right(split)

report summary "Summary" {
  if (is.null(summary_table)) cat("Runs until nobody is infected.\n") else print(summary_table, row.names = FALSE)
} update manual w 10 h 3 .under(split)
