# Two views of one model: the terrain the walkers cross, and a heat map of
# where they have been. Test model for TOFIX item 2 (not in the preset menu).

panel run "Run"
  button setup
  button go forever .right()
  slider population 10..500 = 200 step 10
  slider wiggle 0..90 = 30 step 5
end

view terrain "Terrain and walkers" w 8 h 8 .right(run)
view heat "Visits" world visits turtles none w 8 h 8 .right()

panel counts "" .under(run)
  monitor "walkers" { NLcount(turtles) }
  monitor "most visits" { max(of(world = visits, agents = patches(visits))) } .right()
end
