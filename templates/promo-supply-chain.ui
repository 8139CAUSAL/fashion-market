# Promotion vs. supply chain, on the real roads of Indianapolis.
# One tick is half an hour. Press setup, then go; "simulate futures" plans
# stock from 60 futures of the promotion and tests every supply plan on 60 more.
# The supply plan takes effect at setup.

panel run "Run"
  button setup
  button go forever .right()
  button futures "simulate futures" { simulate_futures() } w 4
end

panel marketing "Marketing's promotion" .under(run)
  slider discount "discount (%)" 10..50 = 30 step 5
  slider promo_days "length (days)" 3..14 = 7 step 1
  slider ad_reach "ad reach (% of households)" 0..100 = 35 step 5
  slider word_of_mouth "word of mouth" 0..0.3 = 0.08 step 0.01
  slider expected_lift "marketing's estimate (× normal)" 1..6 = 3 step 0.5
end

panel crowd "Shoppers" .under(marketing)
  slider households 500..2000 = 1200 step 100
  slider stockpiling "stocking up on a deal" 0..1 = 0.5 step 0.05
  slider switchers "rival brand's buyers (%)" 0..60 = 30 step 5
  slider uncertainty "how unsure the response is (%)" 0..80 = 30 step 5
end

panel chain "Supply chain" .right(run)
  chooser supply_plan "plan" [not told, marketing estimate, simulated P90] = "not told" w 4
  switch share_pos "DC sees store sales" = off w 4
  slider store_lead "DC to store (days)" 1..4 = 2 step 1
  slider plant_lead "plant to DC (days)" 2..10 = 5 step 1
  slider plant_capacity "plant capacity (% of normal)" 110..300 = 200 step 10
  slider safety_days "safety stock (days)" 0..5 = 1.5 step 0.5
end

panel now "Now" .under(chain)
  monitor clock "time" { calendar() } w 4
  monitor promotion "promotion" { promo_status() } w 4
  monitor fill "fill rate %" { fill_rate() } digits 0
  monitor lost "sales lost" { units_lost() } .right()
  monitor store_days "stores (days)" { stock_days("stores") } digits 1
  monitor dc_days "DC (days)" { stock_days("dc") } digits 1 .right()
end

output log .under(now) w 4 h 3

view map w 10 h 11 .right(chain)
note legend "Pink: heard about the deal. White: on the way to the store. Red: turned away at an empty shelf. Squares: stores (green, amber, red by stock) and the DC. Orange: DC trucks. Violet: trucks from the plant on I-70." w 10 h 2 .under(map)

plot chain_plot "Orders up the chain" { plot_chain() } w 7 h 4 .right(map)
plot stock_plot "Stock, and shoppers turned away" { plot_stock() } w 7 h 4 .under(chain_plot)
plot futures_plot "Shopper demand: this run and the simulated futures" { plot_futures() } w 7 h 4 .under(stock_plot)

report plans "Every supply plan through the same futures" { report_plans() } update manual w 17 h 4 .under(legend)

note "Real roads of Indianapolis (OpenStreetMap contributors, ODbL). The retailer, its stores, DC and shoppers are illustrative: every behaviour is a slider." w 17 .under(plans)
