# Monorail loop: constant-direction vs forward-reverse fleets.
# Interface only: the model is still to be ported from
# logo_ui-main/_monorail_code.nlogo. Stations: MK, CO, TTC, PO, GF.

# ---- Left column ------------------------------------------------------
panel run "Run control"
  button setup "SETUP"
  button go "GO" forever .right()
  button export_csv "EXPORT CSV" w 3 .right()
  switch record_invehicle "record-invehicle?" = off w 4
  input seed = 0
  slider horizon_hours "horizon-hours" 1..24 = 12 step 1 w 7
end

panel policies "Policies / fleets / capacity" .under(run)
  chooser constant_dir "constant-dir" [CW, CCW] = CW w 3
  chooser fwdrev_initial_dir "fwdrev-initial-dir" [CW, CCW] = CW w 4 .right()
  slider constant_trains "constant-trains" 0..10 = 3 step 1 w 3
  slider fwdrev_trains "fwdrev-trains" 0..10 = 3 step 1 w 4 .right()
  slider train_capacity "train-capacity" 10..200 = 60 step 5 w 7
  slider min_headway_blocks "min-headway-blocks" 1..3 = 2 step 1 w 7
  switch enable_reversal "enable-reversal" = on w 4
end

panel dwell "Dwell controls" .under(policies)
  for d in [base, alpha, beta]
    input dwell_{d}_sec "dwell-{d}-sec" = 30 w 7
  end
end

panel arrivals "Arrivals λ (guests/min)" .under(dwell)
  note "" w 1
  for b in [morning, midday, evening]
    note "{b}" w 2 .right()
  end
  for s in [MK, CO, TTC, PO, GF]
    note "{s}" w 1
    for b in [morning, midday, evening]
      slider lam_{s}_{b} "" 0..10 = 2 step 0.1 w 2 .right()
    end
  end
end

panel export "Export" .under(arrivals)
  input export_filename "export-filename" = "monorail_results.csv" w 7
end

# ---- Centre column: the view, then time settings ------------------------
view w 9 h 8 .right(run)

panel time "Time & buckets" .under(view)
  input morning_start_hhmm "morning-start-hhmm" = "06:00" w 4
  input midday_start_hhmm "midday-start-hhmm" = "11:00" w 5 .right()
  input evening_start_hhmm "evening-start-hhmm" = "17:00" w 4
  input fwdrev_switch_hhmm "fwdrev-switch-hhmm" = "12:00" w 5 .right()
end

panel travel "Travel times (minutes)" .under(time)
  input travel_cw_min "CW leg times (min)" = "3 2 2 2 3" w 9
  input travel_ccw_min "CCW leg times (min)" = "3 2 2 2 3" w 9
end

# ---- Right column: results, then the O→D matrix editor ------------------
panel kpi "KPI monitors" .right(view)
  monitor "sim-minutes" { ticks / 60 } digits 1
  monitor "current-bucket" { bucket_of_ticks() } .right()
  monitor "reversal-fired?" { reversal_fired } .right()
  monitor "trains-const" { NLcount(NLwith(agents = trains, var = "mode", val = "constant")) }
  monitor "trains-fwdrev" { NLcount(NLwith(agents = trains, var = "mode", val = "fwdrev")) } .right()
  monitor "avg wait (min), constant" { avg_wait_min("constant") } digits 2 w 3
  monitor "avg wait (min), fwdrev" { avg_wait_min("fwdrev") } digits 2 w 3 .right()
end

panel waits "Wait (min) by time of day: constant | fwdrev" .under(kpi)
  note "" w 2
  for b in [all day, morning, midday, evening]
    note "{b}" w 4 .right()
  end
  for dir in [to, from]
    for s in [CO, TTC, PO, GF]
      note "{s} {dir} MK" w 2
      for b in [all day, morning, midday, evening]
        for p in [constant, fwdrev]
          monitor "" { avg_wait_{dir}_mk("{s}", "{p}", "{b}") } digits 2 .right()
        end
      end
    end
  end
end

panel od "O→D matrix editor" .under(waits)
  for b in [morning, midday, evening]
    note "{b}" w 2
    for d in [MK, CO, TTC, PO, GF]
      note "{d}" w 2 .right()
    end
    for o in [MK, CO, TTC, PO, GF]
      note "{o}" w 2
      for d in [MK, CO, TTC, PO, GF] if d != o
        input od_{b}_{o}_{d} "" = 0.25 w 2 .right()
      end
      button "Unif" { od_uniform("{b}", "{o}") } .right()
      button "Norm" { od_normalize("{b}", "{o}") } .right()
    end
  end
end
