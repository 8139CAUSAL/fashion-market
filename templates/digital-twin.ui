# Digital twin of a promotion, on the real roads and supermarkets of Indianapolis.
# Both worlds hold the same households making the same trips with the same luck;
# only the right-hand one runs Store A's coupon. One tick is two minutes.
# Sliders take effect the next morning; households and the stock at setup.

panel run "Run"
  button setup w 3
  button go forever w 3 .right()
end

panel promo "Store A's promotion" .under(run)
  slider discount "discount on the promoted range (%)" 0..50 = 30 step 5 w 6
  slider radius "coupon mailed within (km)" 1..30 = 6 step 1 w 6
  slider promo_days "length (days)" 2..7 = 4 step 1 w 6
end

panel shoppers "Shoppers" .under(promo)
  slider households 1000..5000 = 3000 step 500 w 6
  slider travel_cost "cost of driving ($ a minute)" 0.1..2 = 0.5 step 0.05 w 6
  slider loyalty "loyalty to their usual store ($)" 0.5..10 = 3 step 0.5 w 6
end

panel supply "Store A's promoted range" .under(shoppers)
  slider deal_stock "stock at the start (days of sales)" 1..15 = 4 step 1 w 6
  slider restock_lead "restock lead time (days)" 1..5 = 2 step 1 w 6
end

panel score "Store A" .under(supply)
  monitor clock "" { calendar() } w 6
  note "" w 2
  note "without" w 2 .right()
  note "with" w 2 .right()
  note "shoppers today" w 2
  for w in [without, with]
    monitor shoppers_{w} "" { a_shoppers("{w}") } w 2 .right()
  end
  note "in the store now" w 2
  for w in [without, with]
    monitor crowd_{w} "" { a_in_store("{w}") } w 2 .right()
  end
  note "wait at the tills (min)" w 2
  for w in [without, with]
    monitor wait_{w} "" { a_wait("{w}") } digits 0 w 2 .right()
  end
  note "range in stock (days)" w 2
  for w in [without, with]
    monitor stock_{w} "" { a_stock("{w}") } digits 1 w 2 .right()
  end
  note "shelf found empty" w 2
  for w in [without, with]
    monitor empty_{w} "" { so_far("{w}", "let_down") } w 2 .right()
  end
  note "Store A's sales" w 2
  for w in [without, with]
    monitor sales_{w} "" { money(so_far("{w}", "a_sales")) } w 2 .right()
  end
  note "chain's gross profit" w 2
  for w in [without, with]
    monitor profit_{w} "" { money(so_far("{w}", "chain_profit")) } w 2 .right()
  end
  note "rivals' sales" w 2
  for w in [without, with]
    monitor rivals_{w} "" { money(so_far("{w}", "rival_sales")) } w 2 .right()
  end
end

output log .under(score) w 6 h 4

view without "Without the promotion" turtles turtles_without w 8 h 9 .right(run)
view with "With the promotion" world world_with colors with_colors turtles turtles_with w 8 h 9 .right(without)
note legend "Dots are households, coloured by where they last shopped: pink Store A, blue the chain's other stores, grey rival supermarkets. With the promotion, green ones came from a rival, amber ones from the chain's own stores, and red ones found the promoted range sold out. Squares are the supermarkets, growing with the day's shoppers; Store A turns orange as the range runs low and red when it's gone. The ring is where the coupon went." w 16 .under(without)

plot visits_plot "Store A's shoppers a day" { plot_visits() } w 5 h 4 .under(legend)
plot stock_plot "Store A's promoted range in stock" { plot_stock() } w 5 h 4 .right()
plot profit_plot "The chain's gross profit, with vs. without" { plot_profit() } w 6 h 4 .right()
report effect "What the promotion changed, trip by trip" { report_effect() } w 16 h 5 .under(visits_plot)

note "Real roads and supermarket sites of Indianapolis (OpenStreetMap contributors, ODbL). The chain, its Store A and the households are illustrative, and so are the dollars: every behaviour is a slider or a constant in the model." w 16 .under(effect)
