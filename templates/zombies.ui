# Zombie outbreak on the real streets of central Göttingen.
# One tick is one minute. Distances are in metres.

button setup
button go forever .right(setup)

slider population 20..500 = 100 step 10 .under(setup)
slider infection_radius 5..30 = 10 step 1 .under(population)
slider wander_chance 0..1 = 0.1 step 0.05 .under(infection_radius)
slider person_size 2..10 = 5 step 1 .under(wander_chance)

monitor "minute" { ticks } .under(person_size)
monitor "humans" { NLcount(NLwith(agents = turtles, var = "infected", val = 0)) } .right(minute)
monitor "zombies" { NLcount(NLwith(agents = turtles, var = "infected", val = 1)) } .under(minute)
monitor "turned %" { 100 * mean(of(agents = turtles, var = "infected")) } digits 1 .right(zombies)

note "Real streets of central Göttingen. Map data © OpenStreetMap contributors (ODbL)."
output log
